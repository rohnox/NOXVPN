<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" /> -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
  <!-- Copy the <permission> block to your app when using the REMOTE API. Otherwise OConnect
        needs to be installed first -->
  <application>
    <activity android:name="app.openconnect.ConnectionEditorActivity" android:exported="false" android:theme="@style/Theme.OConnect" />
    <activity android:name="app.openconnect.FragActivity" android:exported="false" android:theme="@style/Theme.OConnect" />
    <activity android:name="app.openconnect.TokenImportActivity" android:exported="false" android:theme="@style/Theme.OConnect">
    </activity>
    <activity android:name="app.openconnect.FileSelect" android:exported="false" android:theme="@style/Theme.OConnect" />
    <activity android:name="app.openconnect.MainActivity" android:exported="false" android:uiOptions="splitActionBarWhenNarrow" tools:ignore="ExportedActivity" android:theme="@style/Theme.OConnect">
    </activity>
    <service android:name="app.openconnect.core.OpenVpnService" android:exported="false" android:foregroundServiceType="systemExempted" android:permission="android.permission.BIND_VPN_SERVICE" tools:ignore="ForegroundServicePermission">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
    </service>
    <service android:name="app.openconnect.core.QuickSettingsTileService" android:exported="false" android:icon="@drawable/ic_stat_vpn" android:label="@string/quick_settings_label" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
    </service>
    <!--
        <service
            android:name="app.openconnect.api.ExternalOpenVPNService"
            android:permission="io.pengyue.oconnect.REMOTE_API" >
            <intent-filter>
                <action android:name="io.pengyue.oconnect.api.IOpenVPNAPIService" />
            </intent-filter>
        </service>
-->
    <receiver android:name="app.openconnect.OnBootReceiver" android:exported="false">
    </receiver>
    <provider android:name="app.openconnect.FileProvider" android:authorities="${applicationId}.FileProvider" android:exported="false" android:grantUriPermissions="true" tools:ignore="ExportedContentProvider" />
    <!--
        <receiver android:name="core.GetRestrictionReceiver">
            <intent-filter>
                <action android:name="android.intent.action.GET_RESTRICTION_ENTRIES" />
            </intent-filter>
        </receiver>
        -->
    <activity android:name="app.openconnect.api.GrantPermissionsActivity" android:exported="false" android:theme="@style/Theme.OConnect" />
  </application>
</manifest>
