                        {
                            "id": "ModifierFactoryExtensionFunction",
                            "shortDescription": {
                                "text": "Modifier factory functions should be extensions on Modifier"
                            },
                            "fullDescription": {
                                "text": "Modifier factory functions should be defined as extension functions on Modifier to allow modifiers to be fluently chained."
                            },
